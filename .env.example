# =============================================================================
# Copy to .env and fill in real values:  cp .env.example .env
# Used by Frappe stack AND external n8n (projekt_z_n8n on :5678)
# =============================================================================

TZ=Europe/Berlin

# ---------------------------------------------------------------------- n8n --
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# --------------------------------------------------------------------- vapi --
VAPI_API_KEY=vapi_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ^ Private Key from Vapi dashboard. Code node strips the vapi_sk_ prefix for Bearer auth.
VAPI_ASSISTANT_ID=00000000-0000-0000-0000-000000000000
VAPI_PHONE_NUMBER_ID=11111111-1111-1111-1111-111111111111
# ^ Must be exactly 36 chars (UUID). Copy Phone Number ID from Vapi — no extra digits.

# ------------------------------------------------------------------- frappe --
FRAPPE_IMAGE=frappe/erpnext:v15.44.0
FRAPPE_SITE_NAME=crm.localhost
FRAPPE_PORT=8083
FRAPPE_BASE_URL=http://frontend:8080
ADMIN_PASSWORD=admin
DB_ROOT_PASSWORD=frappe_root_pass

FRAPPE_API_KEY=frappe_api_key_here
FRAPPE_API_SECRET=frappe_api_secret_here
