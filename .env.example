# =============================================================================
# Copy to .env and fill in real values:  cp .env.example .env
# Used by optional Frappe stack AND external n8n (projekt_z_n8n on :5678)
# =============================================================================

TZ=Europe/Berlin

# ---------------------------------------------------------------------- n8n --
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
# Public URL for Retell webhooks. Quick-tunnel changes on restart — use tunnel-watchdog.ps1
# or CLOUDFLARE_TUNNEL_TOKEN for a stable named tunnel (see scripts/setup-named-tunnel.ps1).
PUBLIC_WEBHOOK_URL=https://your-tunnel-host.trycloudflare.com/
# Optional — stable Cloudflare Named Tunnel token (leave empty for quick-tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# --------------------------------------------------------------------- retell --
# API key from Retell dashboard → Settings → API Keys
RETELL_API_KEY=your_retell_api_key_here
# Agent ID from Retell → Agents → open agent → copy from URL or settings
RETELL_AGENT_ID=your_agent_id_here
# Zadarma number connected in Retell Phone Numbers
RETELL_FROM_NUMBER=+48324412887

# ----------------------------------------------------------- google sheets --
# Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_DOCUMENT_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_SHEET_NAME=Leads

# ------------------------------------------------------------------- frappe --
# Optional — only if you still run docker compose (legacy ERPNext stack).
FRAPPE_IMAGE=frappe/erpnext:v15.44.0
FRAPPE_SITE_NAME=crm.localhost
FRAPPE_PORT=8083
FRAPPE_BASE_URL=http://frontend:8080
ADMIN_PASSWORD=admin
DB_ROOT_PASSWORD=frappe_root_pass

FRAPPE_API_KEY=frappe_api_key_here
FRAPPE_API_SECRET=frappe_api_secret_here
