# ---------------------------------------------------------------- google calendar --
# Calendar used for trial session booking (use "primary" or a specific calendar ID)
GOOGLE_CALENDAR_ID=primary
STUDIO_TIMEZONE=Europe/Warsaw
STUDIO_OPEN_HOUR=8
STUDIO_CLOSE_HOUR=20
STUDIO_WORK_DAYS=1,2,3,4,5
BOOKING_DURATION_MINUTES=60

# ------------------------------------------------------------------ tunnel --
# Quick-tunnel (tymczasowo — URL zmienia sie po restarcie cloudflared):
#   PUBLIC_WEBHOOK_URL=https://xxx.trycloudflare.com/
#   Uruchom w tle: powershell -File scripts\start-tunnel-watchdog.ps1
#
# Named tunnel (STALY URL — wymaga domeny w Cloudflare, darmowe konto):
#   CLOUDFLARE_TUNNEL_TOKEN=eyJ...   (z Zero Trust dashboard)
#   PUBLIC_WEBHOOK_URL=https://webhook.twojadomena.pl/
#   Setup: powershell -File scripts\setup-named-tunnel.ps1 -Hostname webhook.twojadomena.pl -Token "eyJ..."
#
# --------------------------------------------------------------------- retell --
# RETELL_AGENT_ID=inbound agent (odbieranie telefonow)
# RETELL_INBOUND_AGENT_ID=agent_edfc81cbe141dc83d40217c3b1 (Studio Treningowe — Inbound PL)
# RETELL_OUTBOUND_AGENT_ID=outbound agent Paulina (oddzwanianie Meta) - opcjonalnie osobny
# Push promptow: node scripts/push-inbound-prompt.mjs | node scripts/push-outbound-prompt.mjs
# Jesli brak RETELL_OUTBOUND_AGENT_ID, Flow A uzyje RETELL_AGENT_ID
# RETELL_API_KEY=
# RETELL_FROM_NUMBER=+48324412887
# RETELL_KB_ID=  (ustawiane przez node scripts/push-faq-knowledge-base.mjs)
# PUBLIC_WEBHOOK_URL=https://twoj-tunnel.trycloudflare.com/

# ------------------------------------------------------------------- frappe --