{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "lib": ["ES2021"],
    "types": ["node"],
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "removeComments": true,
    "outDir": "./dist",
    "declaration": false
  },
  "include": ["*.ts"],
  "exclude": ["mapVapiToSheets.ts", "tests"]
}
