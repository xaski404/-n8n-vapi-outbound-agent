{
  "_comment": "Reference body for POST https://api.vapi.ai/call. Production source: scripts/build-workflow.mjs → Build Vapi Payload node.",

  "assistantId": "={{ $env.VAPI_ASSISTANT_ID }}",
  "phoneNumberId": "={{ $env.VAPI_PHONE_NUMBER_ID }}",

  "customer": {
    "number": "={{ $json.phoneE164 }}",
    "name": "={{ $json.fullName }}"
  },

  "assistantOverrides": {
    "variableValues": {
      "full_name": "={{ $json.fullName }}",
      "first_name": "={{ $json.firstName }}",
      "phone_number": "={{ $json.phoneE164 }}",
      "campaign_name": "={{ $json.campaignName }}",
      "leadgen_id": "={{ $json.leadgenId }}"
    },

    "firstMessageMode": "assistant-speaks-first",
    "firstMessage": "Cześć {{first_name}}, tu Morgan. Dzwonię w sprawie formularza z kampanii {{campaign_name}}. Czy masz teraz chwilę?",

    "model": {
      "provider": "openai",
      "model": "gpt-4o-mini",
      "messages": [
        {
          "role": "system",
          "content": "Jesteś Morgan, asystentką głosową. Mów WYŁĄCZNIE po polsku. Dzwonisz do {{first_name}} w sprawie kampanii Meta „{{campaign_name}}”."
        }
      ]
    },

    "transcriber": {
      "provider": "deepgram",
      "model": "nova-2",
      "language": "pl"
    },

    "voice": {
      "provider": "azure",
      "voiceId": "pl-PL-ZofiaNeural"
    },

    "analysisPlan": {
      "summaryPrompt": "Podsumuj rozmowę po polsku w 2–3 zdaniach na notatkę CRM.",
      "structuredDataPlan": {
        "enabled": true,
        "schema": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": ["interested", "not_interested", "callback", "no_answer", "voicemail"],
              "description": "Finalna klasyfikacja rozmowy."
            },
            "callback_at": { "type": "string", "description": "ISO datetime jeśli umówiono oddzwonienie." },
            "budget": { "type": "string", "description": "Budżet podany przez leada." },
            "notes": { "type": "string", "description": "Krótka notatka dla handlowca." }
          },
          "required": ["outcome"]
        }
      }
    },

    "serverMessages": ["end-of-call-report"]
  }
}
